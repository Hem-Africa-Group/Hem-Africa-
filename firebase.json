{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      { "source": "**", "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }] }
    ],
    "redirects": [
      { "source": "/status", "destination": "/status.html", "type": 302 }
    ]
  }
}
